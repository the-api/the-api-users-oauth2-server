# In addition to the DB_*, DB_WRITE_* and AUTH_* environment of the-api-users.
JWT_SECRET=replace-with-the-same-secret-used-by-the-api-users
OAUTH_ISSUER=https://accounts.example.com
# JSON containing dedicated RSA JWKs. See README for generation; never commit real keys.
OAUTH_JWKS_JSON=
# Optional, only for running integration tests against a dedicated database.
OAUTH_TEST_DATABASE_URL=
