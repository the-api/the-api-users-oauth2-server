{
  "name": "the-api-users-oauth2-server",
  "version": "0.1.1",
  "description": "OAuth2 and OpenID Connect server for the-api-users",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "migrationsUpdate",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "check:examples": "tsc -p tsconfig.examples.json",
    "build": "bun build ./src/index.ts --outdir ./dist --target=node --external hono --external jose --external the-api-routings && tsc",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "hono": "^4.12.2",
    "jose": "^6.1.0",
    "the-api-routings": "^0.13.1"
  },
  "peerDependencies": {
    "the-api": "^22.13.1",
    "the-api-users": "^0.9.1",
    "the-api-roles": "^1.1.2",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "the-api": "^22.13.1",
    "the-api-users": "^0.9.1",
    "the-api-roles": "^1.1.2",
    "knex": "^3.1.0",
    "pg": "^8.19.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "overrides": {
    "the-api": "link:the-api",
    "the-api-routings": "link:the-api-routings",
    "the-api-users": "link:the-api-users",
    "the-api-roles": "link:the-api-roles"
  }
}
